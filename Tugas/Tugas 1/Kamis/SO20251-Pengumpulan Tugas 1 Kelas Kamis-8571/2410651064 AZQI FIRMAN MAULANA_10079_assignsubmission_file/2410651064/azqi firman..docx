@keyframes flyoutFadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@-webkit-keyframes flyoutFadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes flyoutFadeOut { 
  0% { opacity: 1; }
  100% { opacity: 0; }
}

@-webkit-keyframes flyoutFadeOut { 
  0% { opacity: 1; }
  100% { opacity: 0; }

.WACButton, input#applicationfileInput { outline: none; }

.WACButton { background-color: rgb(255, 255, 255); border: 1px solid rgb(138, 136, 134); color: rgb(68, 68, 68); }

.WACGlyph { background-color: transparent; border: 1px solid transparent; outline: none; }

.WACButton:focus, .WACGlyph:focus { background-color: rgb(227, 236, 250); border-color: rgb(0, 0, 0); outline: transparent dashed 2px; }

.usehover .WACButton:hover, .usehover .WACGlyph:hover { background-color: rgb(213, 225, 242); border-color: rgb(163, 189, 227); outline: transparent dashed 2px; }

.WACButton:active, .WACGlyph:active { background-color: rgb(163, 189, 227) !important; border-color: rgb(62, 109, 181) !important; }

.WACButton:disabled { color: rgb(119, 119, 119); background-color: rgb(240, 240, 240) !important; border-color: rgb(198, 198, 198) !important; }

.WACDialogOverlay { background: rgb(198, 198, 198); display: none; left: 0px; opacity: 0.5; position: absolute; top: 0px; width: 100%; z-index: 998; }


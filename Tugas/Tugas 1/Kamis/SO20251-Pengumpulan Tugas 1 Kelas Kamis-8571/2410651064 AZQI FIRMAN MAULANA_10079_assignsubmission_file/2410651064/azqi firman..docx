.Gripper, .Themed .Gripper { background-color: var(--clrDocSurfaceBg,window); border-color: var(--clrGripperBorder,#212121); border-style: solid; }

.Themed.iPad .Gripper, .iPad .Gripper { border-color: var(--clrGripperBorderIpad,#5164EF); }

.GripperContainer { position: absolute; touch-action: none; z-index: 600; }

.Mac .Gripper, .Mac .Themed .Gripper { background-color: var(--clrDocSurfaceBgExplicit,#ffffff); }

.GripperTargetArea { left: 0px; opacity: 0; position: absolute; top: 0px; }

.GripperTargetArea, .Themed .GripperTargetArea { background-color: var(--clrDocSurfaceBg,window); }

.Mac .GripperTargetArea, .Mac .Themed .GripperTargetArea { background-color: var(--clrDocSurfaceBgExplicit,#ffffff); }

.GrippersContainer { max-height: 0px; max-width: 0px; overflow: visible; }

.HiddenGrippers { visibility: hidden; }

.EditMode .Hyperlink { cursor: text; }

.ReadingMode .Hyperlink { cursor: pointer; }

.WACUploadFrame { visibility: hidden; z-index: -1; }

div.Outline { overflow: visible; position: absolute; top: 0px; z-index: 1; }

.OutlineContainer.Ltr div.Outline { left: 0px; }

.OutlineContainer.Rtl div.Outline { right: 0px; }

div.SingleOutlineLayout.WithAuthorInfo div.Outline { right: 20%; }

div.SingleOutlineLayout.Rtl.WithAuthorInfo div.Outline { left: 20%; }

.WACDocumentPanel.ReadingMode .WACViewPanel div.Outline, .WACDocumentPanelPositionGrid.ReadingMode .WACViewPanel div.Outline { border: none; }

div.OutlineGroup { cursor: text; overflow: visible; position: relative; }

div.OutlineGroup::after, div.OutlineGroup::before { content: ""; display: table; }

div.ListContainerWrapper { position: relative; }

div.OutlineElement, div.ParagraphTrackItem { clear: both; cursor: text; overflow: visible; position: relative; }

div.OutlineElement.Ltr { direction: ltr; }

div.OutlineElement.Rtl { direction: rtl; }

div.TitleDateTimeOutline > div.OutlineElement.Rtl { width: 89%; }

.AppRtl div.TitleDateTimeOutline > div.OutlineElement.Rtl { width: auto; }

.AppRtl div.TitleDateTimeOutline > div.OutlineElement.Ltr { width: 89%; }

li.OutlineElement { clear: both; cursor: text; overflow: visible; position: relative; }

li.OutlineElement.Ltr { direction: ltr; }

li.OutlineElement.Rtl { direction: rtl; text-align: right; }

li.OutlineElement.VerticalCenter { vertical-align: middle; }

.ListMarkerGalleryPreviewLine { background-color: rgb(170, 170, 170); height: 2px; margin-left: 4px; margin-right: 4px; outline: transparent solid 1px; position: absolute; top: 50%; width: 100%; }

.ListMarker { display: inline-block; height: 1px; visibility: visible; }

ul.BulletListStyle1 { list-style-type: disc; }

ul.BulletListStyle1, ul.BulletListStyle2 { cursor: text; font-family: verdana; overflow: visible; }

ul.BulletListStyle2 { list-style-type: circle; }

ul.BulletListStyle3 { cursor: text; font-family: verdana; font-size: 8pt; list-style-type: square; overflow: visible; }

ol.NumberListStyle1 { cursor: text; list-style-type: decimal; overflow: visible; }

ol.NumberListStyle2 { cursor: text; list-style-type: lower-alpha; overflow: visible; }

ol.NumberListStyle3 { cursor: text; list-style-type: lower-roman; overflow: visible; }

ol.NumberListStyle4 { cursor: text; list-style-type: upper-alpha; overflow: visible; }

ol.NumberListStyle5 { cursor: text; list-style-type: upper-roman; overflow: visible; }

.NoteTagContainer { display: inline-block; float: left; height: 0px; overflow: visible; position: absolute; visibility: visible; width: 0px; }

.Safari .NoteTagContainer { display: inline; }

.NoteTagImage { cursor: default; height: 16px; position: absolute; width: 16px; }

.ListGhost, .NoteTagNoImage { display: none; }

.ParaWrappingDiv { position: relative; }

.Paragraph { margin: 0px; }

.ParagraphLite { background-color: transparent; color: var(--clrWindowText,WindowText); font-style: normal; font-weight: 400; margin: 0px; padding-left: 0px; padding-right: 0px; vertical-align: baseline; }

.Zoomed .Paragraph { will-change: transform; }

.Themed .ParagraphLite { color: var(--clrWindowText,WindowText); }

.Conflict.Paragraph, .Conflict.Table { background-color: rgb(255, 190, 190); }

.Conflict.Paragraph span { border-bottom: 1px dotted rgb(255, 190, 190); margin-bottom: -1px; }

div.TableContainer { margin: 2px 0px 2px -5px; overflow: visible; position: relative; }

div.TableContainer div.TableContainer { margin-left: 0px; }


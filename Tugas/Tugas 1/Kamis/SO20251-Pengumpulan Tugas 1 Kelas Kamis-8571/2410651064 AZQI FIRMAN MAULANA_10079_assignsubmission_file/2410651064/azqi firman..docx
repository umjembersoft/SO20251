.ContentControlAcetateRootContainer { height: 0px; left: 0px; position: absolute; top: 0px; width: 100%; }

.PageContentOrigin .ContentControlAcetateContainer { margin: 0px auto; }

.ContentControlAcetate { position: relative; z-index: 1; }

.ContentControlAcetate .ContentControlAcetateHidden { visibility: hidden; }

.ContentControlAcetateArea { left: 0px; pointer-events: none; position: absolute; top: 0px; }

.ContentControlAcetateArea path { stroke: rgb(176, 179, 158); fill: rgb(176, 179, 158); }

.ContentControlAcetateTitleButton { background-color: rgb(225, 225, 225); border: solid rgb(147, 147, 147); cursor: default; height: 17px; overflow-y: hidden; position: absolute; z-index: 1; }

.ContentControlAcetateTitleButton:hover { background-color: rgb(197, 197, 197); }

.ContentControlAcetateTitleButton:active { background-color: rgb(174, 174, 174); }

.ContentControlAcetateTitleButton * { pointer-events: none; }

.ContentControlAcetateTitleButtonIndicator { color: rgb(119, 119, 119); float: left; line-height: 5px; padding: 0px; }

.ContentControlAcetateTitleButtonTitle { color: rgb(68, 68, 68); float: left; line-height: 17px; padding-right: 3px; }

.ContentControlAcetateArrowButton { background: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyMDQ4IDIwNDgiPjxwYXRoIGQ9Ik01NDYgNzg1aDk1NmwtNDc4IDQ3OHoiIHN0eWxlPSJmaWxsOiM0NDQiLz48L3N2Zz4=") 50% center no-repeat rgb(225, 225, 225); border: 1px solid rgb(147, 147, 147); cursor: default; overflow-y: hidden; position: absolute; width: 17px; z-index: 1; }

.ContentControlAcetateListItemsContainer { background-color: white; border: 2px solid rgb(174, 174, 174); border-radius: 5px; cursor: default; position: absolute; z-index: 1; }

.ContentControlAcetateListItemsElement { background-color: white; border: none; color: black; display: block; margin: 1px; padding: 1px; text-align: left; width: calc(100% - 2px); }

.ContentControlAcetateListItemsElement.Rtl { text-align: right; }

.ContentControlAcetateListItemsElement[aria-selected="true"] { background-color: rgb(0, 120, 215); color: white; }

.ContentControlAcetateNoFocusVisible:focus-visible { box-shadow: none; outline: 0px; }

.ContentControlAcetateRtl .ContentControlAcetateTitleButtonIndicator, .ContentControlAcetateRtl .ContentControlAcetateTitleButtonTitle { float: right; }

.ContentControlAcetateRtl .ContentControlAcetateTitleButtonTitle { padding-left: 3px; padding-right: 0px; }

.ContentControlAcetateTitleButtonTitle.ContentControlAcetateHidden { display: none; }

.ContentControlAcetateTitleButtonOverlay { display: block; height: 100%; opacity: 0.12; width: 100%; }

.ContentControlAcetateTitleButton:active .ContentControlAcetateTitleButtonOverlay, .ContentControlAcetateTitleButton:hover .ContentControlAcetateTitleButtonOverlay { visibility: hidden; }

.tocOptionWrapper { width: 100px; }

.tocOptionWrapper, .tocOptionWrapperNew { height: 40px; position: absolute; z-index: 1; }

.tocOptionWrapperNew { border-radius: 8px; padding-bottom: 15px; transform: translateY(-18px); transition-delay: 0.3s; width: auto; }

.tocOptionBox { background-color: rgb(255, 255, 255); border-radius: 2px; box-shadow: rgba(0, 0, 0, 0.1) 0px 1.2px 3.6px, rgba(0, 0, 0, 0.13) 0px 6.4px 14.4px; cursor: pointer; padding: 3px 8px 4px 5px; position: absolute; }

.tocOptionBoxHidden { visibility: hidden; }

.tocOptionBox .tocUpdateIcon { background-repeat: no-repeat; background-size: contain; display: inline-block; height: 16px; margin-right: 7px; vertical-align: middle; width: 16px; }

.tocShowMeHowOptionBox { border: 1px solid rgb(209, 209, 209); border-radius: 4px; color: var(--clrShowMeHowButtonEmptyTOC,#185ABD); cursor: pointer; padding: 3px 4px; position: absolute; }

img { }

span.AdvancedProofingIssueV2, span.AdvancedProofingIssueV2Themed, span.ContextualSpellingAndGrammarErrorV2, span.ContextualSpellingAndGrammarErrorV2Themed, span.DictationCorrection, span.SimilarityReviewed, span.SimilarityReviewedThemed, span.SimilarityUnreviewed, span.SimilarityUnreviewedThemed, span.SpellingErrorV2, span.SpellingErrorV2Themed { background-position: 0px 100%; background-repeat: repeat-x; }

span.AddInCritiqueThemedBerry, span.AddInCritiqueThemedBlue, span.AddInCritiqueThemedGreen, span.AddInCritiqueThemedLavender, span.AddInCritiqueThemedRed { background-position: 0px 100%; background-repeat: no-repeat; background-size: 100% 2px; }

.Themed span.Selected.FindHit, span.Selected.FindHit { background-color: var(--clrActiveFindHighlightSelection,#bdb76b) !important; }

.Themed span.FindHit, span.FindHit { background-color: var(--clrActiveFindHighlight,#ffee80) !important; }

span.LastReplacedFindHitThemed { background-color: var(--clrLastReplacedFindHit,#dce9f8) !important; }

::highlight(LastReplacedFindHit) { background-color: var(--clrLastReplacedFindHit,#dce9f8) !important; }

.Paragraph { overflow-wrap: break-word; }

.Paragraph.Rtl { direction: rtl; }

.FireFox .TextRun > span, .FireFox span.TextRun { unicode-bidi: embed; }

.Safari .Paragraph, .Safari .Paragraph * { }

.WACImageGroupContainer { display: inline-block; position: relative; }

.WACImageContainer { cursor: default; left: 0px; padding: 0px; position: relative; }

.WACImageContainer.NoPadding { cursor: move; }

span.WACImageContainer { display: inline-block; text-indent: 0px; top: 2px; }

span.WACImageContainer.AttachedToBeginning.ImgSelectionOn.OnlyImageSelected.Selected, span.WACImageContainer.ImgSelectionOn.BlobObject.OnlyImageSelected.Selected { background-color: transparent !important; }

div.WACImageContainer { border: 1px solid transparent; left: 0px; margin-left: -3px; }

div.WACImageContainer.Selected { background-color: rgb(198, 198, 198); padding: 0px; position: relative; }

.BlobObject div.WACErrorPlaceholderTextThemed { white-space: normal !important; }

.WACErrorPlaceholderTextThemed { overflow-wrap: break-word; color: var(--clrErrorPlaceholderText,#000000); font-family: "Segoe UI", Arial, Verdana, Sans-Serif; font-size: 14px; font-weight: 400; letter-spacing: 0px; line-height: 20px; position: relative; text-align: center; vertical-align: middle; caret-color: transparent !important; white-space: normal !important; }

.Selected { cursor: default; }

.Selected.DragDrop { cursor: move; }

.usehover div.WACImageContainer:hover { border: 1px dashed rgb(198, 198, 198); }

.usehover .WACImageContainer.BackgroundImage:hover, .usehover div.WACImageContainer.Selected:hover { border: 1px solid transparent; }

.WACImageOverlay { height: 100%; overflow: hidden; position: absolute; width: 100%; }

.WACImageContainer .WACImageOverlay { inset: 0px; height: auto; width: auto; }

.Selected .WACImageOverlay { background-color: rgb(198, 198, 198); border: 2px solid rgb(198, 198, 198); opacity: 0.62; }

.OnlyImageSelected .WACImageOverlay { opacity: 0; }


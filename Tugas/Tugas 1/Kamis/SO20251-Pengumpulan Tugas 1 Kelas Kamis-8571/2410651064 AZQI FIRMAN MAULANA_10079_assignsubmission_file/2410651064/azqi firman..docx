@keyframes box2l3-expand { 
  22.6667% { transform: scaleX(0.2); }
  46% { transform: scaleX(1); }
  100% { transform: scaleX(1); }
}

#box2l4 { animation: linebox2-opacity var(--anim-props), box2l4-expand var(--anim-props); }

@keyframes box2l4-expand { 
  22.6667% { transform: scaleX(0.1); }
  46% { transform: scaleX(1); }
  100% { transform: scaleX(1); }
}


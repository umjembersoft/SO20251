.WACDialogPanel { background-color: rgb(255, 255, 255); border: 1px solid rgb(43, 87, 154); border-radius: 8px; box-shadow: 0px 14px 28px; color: rgb(68, 68, 68); display: none; min-width: 288px; outline: none; position: absolute; width: auto; z-index: 999; }


.AppLogo { width: 180px; height: 180px; animation: 0.3s cubic-bezier(0.1, 0.9, 0.2, 1) 0s 1 normal both running scaleDownIn, 0.1s linear 0s 1 normal both running fadeIn; }

#load_back { width: 100%; height: 100%; opacity: 1; background-color: rgb(255, 255, 255); position: absolute; z-index: 1050; text-align: center; }

#load_img { width: 100%; height: 100%; position: absolute; text-align: center; display: flex; justify-content: center; align-items: flex-end; flex-wrap: wrap; z-index: 1051; }

.MsLogo path.cFFF { fill: rgb(255, 255, 255); }

.MsLogo path.c74 { fill: rgb(116, 116, 116); }

@media screen and (-ms-high-contrast: active) {
  .MsLogo path.HC { fill: windowtext; }
}

:root { --anim-container-width: 220px; --anim-container-height: 250px; --anim-container-border: none; --w-size: 88px; --w-left: 20px; --line-width: 132px; --line-height: 38.5px; --line-origin-x: 68px; --line-origin-y: calc( (var(--anim-container-height) / 2) - (var(--line-height) * 2) ); --box-radius: 12px; --box-shadow: 3px 5px 5px rgb(0 0 0 / 7%), 3px 7.8px 15px rgb(0 0 0 / 9%), 3px 8px 13px rgb(0 0 0 / 12%); --line-color1: #41a5ee; --line-color2: #2b7cd3; --line-color3: #185abd; --line-color4: #20438e; --total-duration: 3000ms; }


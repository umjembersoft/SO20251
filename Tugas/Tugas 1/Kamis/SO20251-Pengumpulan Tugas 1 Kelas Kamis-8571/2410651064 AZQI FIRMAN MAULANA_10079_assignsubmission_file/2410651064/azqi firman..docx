.cui-taskPaneTitle { font-family: "Segoe UI Light", "Segoe UI", Arial, Verdana, sans-serif; font-size: 16pt; }

.UIFontDialogTextLarge { font-size: 14pt; }

.UIFontDialogText { font-size: 11pt; }

.UIFontDialogButton { font-size: 12pt; }

.UIFontDialogTitle { font-size: 16pt; }

.cui-jewelsubmenu .cui-footerbutton { font-family: "Segoe UI", "Segoe UI Web", Arial, Verdana, sans-serif; font-size: 9pt; }

.cui-jewelsubmenu .cui-mrubutton-title { font-family: "Segoe UI", "Segoe UI Web", Arial, Verdana, sans-serif; font-size: 11pt; }

.cui-jewelsubmenu #lblWheresTheSaveButton-MenuSaveButton .cui-btn-menu-description { font-weight: 400; -webkit-font-smoothing: antialiased; }


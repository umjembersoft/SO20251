#opening_text { position: absolute; align-items: center; width: 400px; height: 29px; font-family: "Segoe UI Semibold", "Segoe UI", "Segoe UI Web", Arial, Verdana, sans-serif; font-style: normal; font-size: 24px; line-height: 120%; margin-top: var(--anim-container-height); flex-wrap: nowrap; display: flex; justify-content: center; font-weight: 600; color: rgb(50, 49, 48); }


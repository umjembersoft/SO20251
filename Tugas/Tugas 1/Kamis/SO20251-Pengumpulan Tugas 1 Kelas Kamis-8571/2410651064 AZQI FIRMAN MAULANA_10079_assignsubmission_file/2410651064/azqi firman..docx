.MsLogo { width: 99px; height: 21px; bottom: 36px; animation: 0.1s linear 0s 1 normal both running fadeIn; position: relative; }

@-webkit-keyframes scaleDownIn { 
  0% { transform: scale3d(1.15, 1.15, 1); }
  100% { transform: scaleX(1); }
}

@keyframes scaleDownIn { 
  0% { transform: scale3d(1.15, 1.15, 1); }
  100% { transform: scaleX(1); }
}

@-webkit-keyframes fadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes fadeIn { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

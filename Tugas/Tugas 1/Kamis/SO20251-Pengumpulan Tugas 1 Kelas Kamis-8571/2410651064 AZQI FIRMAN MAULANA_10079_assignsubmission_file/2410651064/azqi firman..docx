#regionComposerRoot { display: grid; position: absolute; width: 100%; height: 100%; z-index: 1; }

@media only screen and (orientation: landscape) {
  #regionComposerRoot { grid-template-rows: repeat(6, min-content) 1fr repeat(2, min-content); grid-template-columns: repeat(3, min-content) 1fr repeat(1, min-content); }

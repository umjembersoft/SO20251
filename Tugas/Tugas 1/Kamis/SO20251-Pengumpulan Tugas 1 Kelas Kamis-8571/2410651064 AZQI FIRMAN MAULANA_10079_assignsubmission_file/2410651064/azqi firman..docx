.cui-ctl-menu20 .cui-ctl-iconContainer20 { padding-left: 4px; padding-right: 4px; }

.cui-ctl-menulabel { display: inline-block; padding-left: 2px; padding-right: 2px; }

.cui-ctl-menu32 .cui-ctl-menulabel { min-height: 35px; }

.cui-ctl-menu48 .cui-ctl-menulabel { min-height: 51px; }

.cui-ctl-menu32 .cui-ctl-mediumlabel, .cui-ctl-menu48 .cui-ctl-mediumlabel { margin-right: 13px; padding: 3px 0px; }

.cui-ctl-menu32 .cui-ctl-mediumlabel-nodescription { margin-right: 13px; padding: 3px 0px; position: relative; top: 8px; }

.cui-btn-menu-description { overflow-wrap: break-word; margin-left: 0px; margin-right: 13px; max-width: 200px; padding-top: 3px; white-space: normal; }


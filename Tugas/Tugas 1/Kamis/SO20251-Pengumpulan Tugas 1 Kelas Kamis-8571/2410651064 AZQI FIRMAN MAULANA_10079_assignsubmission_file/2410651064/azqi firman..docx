img { border: none; }

.ci { display: inline-block; }

.swBar { background-color: rgb(255, 255, 255); border: 1px solid rgb(182, 182, 182); box-shadow: rgba(0, 0, 0, 0.4) 0px 1px 15px; box-sizing: content-box; display: none; left: auto; margin: 10px; opacity: 0; padding: 20px 10px 10px 20px; right: auto; top: 30px; transition-delay: 0s; transition-duration: 0.5s; transition-property: opacity, top; transition-timing-function: cubic-bezier(0, 0, 0, 1); user-select: none; width: 600px; z-index: 999; position: fixed !important; }

.swBar:focus { outline: none; }

.swBar.closeAnimation { transition-duration: 0.2s; transition-timing-function: cubic-bezier(0.33, 0, 0.67, 1); }

.swBar.HeaderRtl.O365Switcher { padding-left: 10px; padding-right: 20px; }

@media (min-width: 660px) {
  .swBar, .swBar.O365Switcher { width: 600px; }
}

@media (min-width: 900px) {
  .swBar.O365Switcher { width: 840px; }
}

@media (max-width: 899px) and (min-width: 780px) {
  .swBar.O365Switcher { width: 720px; }
}

@media (max-width: 659px) {
  .swBar, .swBar.O365Switcher { width: 480px; }
}

@media (max-width: 539px) {
  .swBar, .swBar.O365Switcher { width: 360px; }
}

@media (max-width: 419px) {
  .swBar, .swBar.O365Switcher { width: 240px; }
}

.swBar.SwitcherLoading { height: 130px; padding: 0px; text-align: center; width: 270px; }

.swBar.SwitcherError { padding: 20px; width: 250px; }

.swBar .swLoadingErrorText { display: none; }

.swBar.SwitcherError .swLoadingErrorText { display: inline; }

.swBar .swLoadingText { display: none; }

.swBar.SwitcherLoading .swLoadingText { display: inline; }

.swLoadingText { color: rgb(0, 0, 0); font-size: 20px; line-height: 130px; }

.swLoadingErrorText { color: rgb(0, 0, 0); }

.swErrorTitle { font-size: 20px; }

.swErrorBody { font-size: 14px; }

.swBar a { text-decoration: none; }

.swBar .arrow { border-width: 0px 8px 8px; border-bottom-style: solid; border-bottom-color: rgb(255, 255, 255); border-left-style: solid; border-left-color: transparent; border-right-style: solid; border-right-color: transparent; border-top-style: initial; border-top-color: initial; display: block; font-size: 0px; height: 0px; left: 6px; line-height: 0; margin: 0px; padding: 0px; position: absolute; top: -8px; width: 0px; }

.HeaderRtl.swBar .arrow { left: auto; right: 6px; }

.swBar .border-arrow { border-bottom-color: rgb(182, 182, 182); top: -9px; }

.swTileList { display: inline-block; list-style: outside none none; margin: 0px; padding: 0px; }

.swTile { margin-bottom: 10px; margin-right: 10px; }

.swTileLink { border: 0px solid transparent; color: rgb(255, 255, 255); margin: 0px; position: relative; text-align: center; }

.swTileLink:focus, .swTileLink:hover { border: 2px solid; margin: -2px; text-decoration: none; }

.swTileLink:focus { outline: 0px; }

.swTile, .swTileLink { display: inline-block; height: 110px; width: 110px; }

.swTile.tilePressed { transform: scale(0.9215); }

.swTileText { bottom: 6px; left: 10px; line-height: 110%; max-width: 90px; position: absolute; text-align: left; }

.HeaderRtl .swTileText { left: auto; right: 10px; text-align: right; }

.headerBarBG { background-color: rgb(255, 255, 255); inset: 0px; display: none; opacity: 0; position: fixed; z-index: 998; }

.clip110x110 { height: 110px; overflow: hidden; position: relative; width: 110px; }

.clip110x110 img, .clip110x110 input { height: auto; margin: 0px; padding: 0px; position: absolute; width: auto; }


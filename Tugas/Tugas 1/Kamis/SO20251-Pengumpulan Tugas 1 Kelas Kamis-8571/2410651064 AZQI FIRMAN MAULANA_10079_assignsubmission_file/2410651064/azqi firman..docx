------MultipartBoundary--T64Q7kj0AJ8onqeqt6Y8HQ5TzqmJfSxXu1Z3HUv68P----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://res.public.onecdn.static.microsoft/officeonline/hashed/4fdc70e65beeeb0b/wordeditor_version4.min.css?wscdt=2

@charset "utf-8";

.headBrand { cursor: default; font-family: SegoeUI-SemiLight-final, "Segoe UI SemiLight", "Segoe UI WPC Semilight", "Segoe UI", Segoe, Tahoma, Helvetica, Arial, sans-serif; font-size: 22px; line-height: 48px; margin-left: 20px; margin-right: 20px; }

.cui-topBar1-transistionalHeaderUI .headBrand { display: inline-block; font-family: "Segoe UI", "Segoe UI Web", Arial, Verdana, sans-serif; font-size: 17px; margin-left: 17px; margin-right: 17px; padding-bottom: 12px; padding-top: 12px; height: 24px !important; line-height: normal !important; width: auto !important; }

.cui-topBar1-transitionalReactHeaderUI .headBrand { display: inline-block; font-family: "Segoe UI", "Segoe UI Web (West European)", -apple-system, BlinkMacSystemFont, Roboto, "Helvetica Neue", sans-serif; font-size: 16px; font-weight: 600; padding: 0px 6px; line-height: 48px !important; width: auto !important; }

@font-face { font-family: "Segoe UI Web Light"; font-style: normal; font-weight: 400; src: local("Segoe UI Light"), url("segoeuil.woff") format("woff"), url("segoeuil.ttf") format("truetype"); }

@font-face { font-family: SegoeUI-SemiLight-final; font-style: normal; font-weight: 400; src: local("Segoe UI SemiLight"), url("segoeui-semilight-final.woff") format("woff"), url("segoeui-semilight-final.ttf") format("truetype"); }

@font-face { font-family: "Segoe UI Web"; font-style: normal; font-weight: 400; src: local("Segoe UI"), url("segoeui.woff") format("woff"), url("segoeui.ttf") format("truetype"); }

* { -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: none; }

.Selectable, input[type="number"], input[type="password"], input[type="text"], input[type="url"], textarea { user-select: text; }

input[type="number"], input[type="password"], input[type="text"], input[type="url"], textarea { appearance: none; padding: 2px; }

input, textarea { outline: none; }

img { }

blockquote, div.WACFrame h1, dl, h2, h3, h4, h5, h6, ol, p, pre, ul { margin: 0px; padding: 0px; }

blockquote, dd, div.WACFrame li { margin-left: 0px; }

.WACScreenReaderOnly { clip: rect(0px, 0px, 0px, 0px); border: 0px; height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; }

div.WACFrame label { cursor: pointer; }

div.WACFrame .WACStatusBarContainer label { cursor: default; }

div.WACFrame fieldset { border: none; }

div.WACFrame { border: none; height: 100%; min-height: 200px; min-width: 640px; position: absolute; width: 100%; }

div.WACFrame.FlexBoxLayout { display: flex; flex: 1 1 auto; flex-flow: column; position: relative; top: 0px; }

div.WACFrame.cui-exth { inset: 48px 0px 0px; height: auto; width: auto; }

div.WACFrame.cui-exth.FlexBoxLayout { display: flex; flex: 1 1 auto; flex-flow: column; position: relative; top: 0px; }

div.WACFrame.cui-exth.FlexBoxLayout.ScrollableRibbon { min-width: 320px; }

div.WACFrame.hiddenHeader { top: 0px !important; }

div.WACFrame.cui-exth.FlexPaneUp { left: 0px; right: 306px; }

.AppRtl div.WACFrame.cui-exth.FlexPaneUp { left: 306px; right: 0px; }

div#WACInnerFrame { display: flex; flex: 1 1 auto; flex-flow: column; height: 100%; position: relative; width: 100%; }

.MLRVisualRefresh#WACInnerFrame { background-color: rgb(237, 235, 233); }

.WACFrame.FlexBoxLayout #WACInnerFrame { height: auto; }

.WACFrame.FlexBoxLayout #WACInnerFrame.RegionComposer { flex-basis: 0px; }

.webkitTouchScrolling { }

.HtmlScratchPad { position: absolute; z-index: -1; }

.HtmlScratchPad.Hidden { display: none; }

.AppHeaderPanel { height: 48px; left: 0px; position: absolute; top: 0px; width: 100%; }

.AppHeaderPanel.FlexBoxLayout { flex: 0 0 auto; position: relative; }

.AppHeaderPanel.RaisedZIndex { z-index: 101; }

.AppHeaderPanel.RaisedZIndexIncrease { z-index: 999; }

.WACStatusBarContainer { bottom: 0px; position: absolute; top: auto; width: 100%; }

.WACStatusBarContainer.FlexBoxLayout { flex: 0 1 23px; position: relative; }

.WACStatusBarContainer.reactStatusBar { flex: 0 1 25px; }

.WACStatusBarContainer.FlexBoxLayout.regionComposer { flex: 1 1 auto; position: relative; }

.FloatLeft { float: left; }

.FloatRight { float: right; }

.prControl, .prControlRtl { margin: 0px; padding: 0px; position: absolute; text-indent: 0px; }

.prGlyph { vertical-align: top; }

.prContainerHr .prGlyph { display: inline-block; }

.prFlyout, .prModernFlyout { cursor: default; padding: 0px; position: absolute; }

.prFlyout { outline: transparent solid 2px; }

.prControl .prFlyout ul { margin: 0px 0px 0px 2px; padding: 0px; }

.prControlRtl .prFlyout ul { margin: 0px 2px 0px 0px; padding: 0px; }

.prControl .prModernFlyout span, .prControlRtl .prModernFlyout span { margin: 0px; padding: 0px; }

.prFlyout ul li { color: rgb(255, 255, 255); list-style-type: none; margin-bottom: 2px; min-width: 50px; overflow: visible; padding: 0px 7px; text-align: center; vertical-align: middle; white-space: nowrap; }

.prModernFlyout span { -webkit-font-smoothing: antialiased; color: rgb(255, 255, 255); display: inline-block; font-family: "Segoe UI", "Segoe UI Web (West European)", -apple-system, BlinkMacSystemFont, Roboto, "Helvetica Neue", sans-serif; font-size: 10px; overflow: hidden; white-space: nowrap; }

.prFlyout ul li:last-child, .prModernFlyout span:last-child { margin-bottom: 0px; }

.prModernFlyout.flyoutExpanded span { bottom: 0px; box-sizing: border-box; max-width: 150px; min-width: 44px; padding: 0px 8px; position: absolute; text-align: left; text-overflow: ellipsis; }

.prModernFlyout.flyoutCollapsed span { bottom: 0px; max-width: 20px; min-width: 0px; padding: 0px; position: absolute; width: 20px; }

.prModernFlyout.flyoutIdle span { border-radius: 6px; bottom: 0px; height: 6px; max-width: 6px; min-width: 0px; padding: 0px; position: absolute; width: 6px; }

.prModernFlyout.flyoutFromIdle span { transition-duration: 0.3s; transition-property: height, min-width, max-width, width, border-radius, padding; transition-timing-function: cubic-bezier(0.8, 0, 0.2, 1); }

.prModernFlyout.flyoutFromIdle { transition: top 0.3s cubic-bezier(0.8, 0, 0.2, 1); }

.prModernFlyout.flyoutExpanded.flyoutFromCollapsed span { transition-duration: 0.3s; transition-timing-function: cubic-bezier(0.8, 0, 0.2, 1); }

.prModernFlyout.flyoutExpanded.flyoutFromCollapsed.flyoutRtlDir span { transition-property: min-width, max-width, width, padding-left, visibility; }

.prModernFlyout.flyoutExpanded.flyoutFromCollapsed.flyoutLtrDir span { transition-property: min-width, max-width, width, padding-right, visibility; }

.prModernFlyout.flyoutExpanded.flyoutFromCollapsed.flyoutStacked { animation: 0.3s cubic-bezier(0.8, 0, 0.2, 1) 0s 1 normal none running flyoutFadeIn; transition-duration: 0.3s; transition-property: top; transition-timing-function: cubic-bezier(0.8, 0, 0.2, 1); }

.prModernFlyout.flyoutCollapsed.flyoutFromExpanded span { transition-duration: 0.2s; transition-property: min-width, max-width, width, padding; transition-timing-function: cubic-bezier(0.1, 0.9, 0.2, 1); }

.prModernFlyout.flyoutCollapsed.flyoutFromExpanded.flyoutFromStacked span { transition-duration: 0ms; transition-property: min-width, max-width, width, padding; }

.prModernFlyout.flyoutFadeOut span { animation: 0.2s cubic-bezier(0.1, 0.9, 0.2, 1) 0s 1 normal none running flyoutFadeOut; opacity: 0; }

.prModernFlyout.flyoutIdle.flyoutFromCollapsed span, .prModernFlyout.flyoutIdle.flyoutFromExpanded span { transition-duration: 0.2s; transition-property: height, min-width, max-width, width, border-radius, padding; transition-timing-function: cubic-bezier(0.1, 0.9, 0.2, 1); }

.prModernFlyout.flyoutIdle.flyoutFromCollapsed, .prModernFlyout.flyoutIdle.flyoutFromExpanded { transition: top 0.2s cubic-bezier(0.1, 0.9, 0.2, 1); }

.prTouchTarget { position: absolute; visibility: visible; }

.prContainerHr, .prFlyoutContainer { display: inline-block; position: absolute; top: 0px; }

.prControl .prContainerHr, .prControlRtl .prFlyoutContainer { right: 0px; }

.prControl .prFlyoutContainer, .prControlRtl .prContainerHr { left: 0px; }

.prFlyoutContainer.prBackgroundSelection { opacity: 0.2; }

.prControl .prContainerHr .prGlyph { margin: 0px; padding-left: 2px; }

.prControlRtl .prContainerHr .prGlyph { margin: 0px; padding-right: 2px; }

.prControl .prContainerHr .prGlyph:first-child { padding-left: 0px; }

.prControlRtl .prContainerHr .prGlyph:first-child { padding-right: 0px; }

.prContainerV { bottom: 0px; display: block; left: 0px; position: absolute; }

.prContainerV .cui-img-16by16 { margin-top: 2px; }

.prDancingDots { fill: rgb(255, 255, 255); }

@media screen and (-ms-high-contrast:active) {
  .prDancingDots { fill: windowtext; }
}

@media screen and (forced-colors: active) {
  .prDancingDots { fill: canvastext; }
}

.prAnimateCircle-1 { animation: 2.6s ease 0s infinite normal both running prCircleDance-1; transform-origin: 20px 35px; }

.prAnimateCircle-2 { animation: 2.6s ease 0s infinite normal both running prCircleDance-2; transform-origin: 60px 35px; }

.prAnimateCircle-3 { animation: 2.6s ease 0s infinite normal both running prCircleDance-3; transform-origin: 100px 35px; }


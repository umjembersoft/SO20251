}

@media (forced-colors: active) {
  .GrabberHovered { border: 1px solid linktext; }
  .GrabberActive { border: 1px solid highlight; }
  div.TableInsertColumnGapRevamped, div.TableInsertRowGapRevamped { background-color: linktext !important; }
  .TableCellSelectedRevamped { outline: highlight solid 1px; }
  div.SelectTableHandleRevamped:hover { border: 1px solid linktext; border-radius: 10px; }
  div.insertionDot { background-color: canvas; border-color: canvastext; }
  div.TableInsertColumnHandleRevamped, div.TableInsertRowHandleRevamped { background-color: canvas; border: 1px solid canvastext; height: 14px; width: 14px; }
}

@media screen and (-ms-high-contrast:black-on-white), screen and (forced-colors: active) and (prefers-color-scheme: light) {
  div.TableInsertColumnHandleRevamped, div.TableInsertRowHandleRevamped { background-color: canvastext; }
}

@media screen and (-ms-high-contrast:active), screen and (forced-colors: active) {
  table td, table th { position: relative; z-index: 1; }
  table td .TableCellContent, table th .TableCellContent { margin: 1px; overflow: hidden; position: relative; z-index: 0; }
  table td .TextRun, table th .TextRun { box-sizing: border-box; display: inline-block; max-width: 100%; vertical-align: top; }
}

.PerfUXControl { align-items: center; bottom: 0px; cursor: pointer; font-size: 10px; font-weight: 600; height: 20px; padding: 0px 7px; position: absolute; text-indent: 0px; text-shadow: none; }

.PerfUXControl, .PerfUXTable { display: block; right: 2px; z-index: 100; }

.PerfUXTable { background-color: rgb(96, 94, 92); border: 2px solid rgb(32, 31, 30); border-radius: 2px; bottom: 24px; color: rgb(255, 255, 255); display: none; font-size: 12px; font-weight: 400; max-height: 400px; overflow-y: scroll; padding: 10px; position: fixed; text-align: right; }

.PerfUXTableTH { border-bottom: 1px solid rgb(32, 31, 30); display: table-cell; font-weight: 700; padding: 4px 0px 12px; vertical-align: inherit; }

.PerfUXTableTR { border-color: inherit; display: table-row; vertical-align: inherit; }

.PerfUXTableTDColOne { border-right: 1px solid rgb(32, 31, 30); }

.PerfUXTableTDColOne, .PerfUXTableTDColTwo { display: table-cell; padding: 0px 16px; vertical-align: inherit; }

.CopilotHighlight { background: var(--clrCopilotHighlightGradStart) !important; }

.CopilotSelection { background-color: var(--clrCopilotSelection,rgba(209,209,209,.5)) !important; }

@keyframes blinking { 
  50% { background: none; }
}

.caretForCanvas { animation: 0.75s step-end 0s infinite normal none running blinking; position: absolute; width: 1px; }

.CopilotFixAllUnderline { background-image: var(--urlFixAllUnderline) !important; background-position: center bottom !important; background-repeat: no-repeat !important; background-size: 100% 2px !important; }

.CopilotFixAllSelectionHighlight { background-color: var(--clrFixAllSelectionHighlight) !important; }

.CopilotFixAllNudgeSpellingBarStart { box-shadow: -2px 0 var(--clrSpellingCorrectionsTextDecor,#EB0000) !important; }

.CopilotFixAllNudgeSpellingBarEnd, .CopilotFixAllNudgeSpellingBarStart { background-color: var(--clrSpellingErrorHighlightBg,#ffe5e5) !important; }

.CopilotFixAllNudgeSpellingBarEnd { box-shadow: 2px 0 var(--clrSpellingCorrectionsTextDecor,#EB0000) !important; }

.CopilotFixAllNudgeGrammarBarStart { box-shadow: -2px 0 var(--clrGrammarCorrectionsTextDecor,#3355FF) !important; }

.CopilotFixAllNudgeGrammarBarEnd, .CopilotFixAllNudgeGrammarBarStart { background-color: var(--clrGrammarErrorHighlightBg,#eaeeff) !important; }

.CopilotFixAllNudgeGrammarBarEnd { box-shadow: 2px 0 var(--clrGrammarCorrectionsTextDecor,#3355FF) !important; }

.CopiloRewriteNudgeBarStart { box-shadow: rgb(87, 76, 181) -2px 0px 0px !important; }

.CopiloRewriteNudgeBarStart, .CopilotRewriteNudgeBarEnd { background-color: var(--clrCritiqueIndicatorHighlightBg,#e3dffa) !important; }

.CopilotRewriteNudgeBarEnd { box-shadow: rgb(87, 76, 181) 2px 0px 0px !important; }

div.WACFrame { top: 48px; }

div.MLRVisualRefresh#WACInnerFrame, div.WACFrame { background-color: rgb(243, 243, 243); }

div.ThemedFishbowl.MLRVisualRefresh#WACInnerFrame { background-color: var(--clrMlrRefreshCanvasBgNew,#f3f3f3); }

div.FishbowlBackgroundEnhancementEnabled#WACInnerFrame { background-color: var(--clrEnhancedFishbowlBackgroundColor); }

div.ThemedFishbowl.FishbowlBackgroundEnhancementEnabled#WACInnerFrame { background-color: var(--clrEnhancedFishbowlBackgroundColor,#f5f5f5); }

.AppHeaderPanel { background-color: rgb(225, 225, 225); }

.PlaceholderTextThemed { display: block; left: 1px; position: absolute; top: 0px; visibility: visible; }

.PlaceholderTextThemed.Rtl { left: unset; right: 1px; }

.PlaceholderTextThemed::before { color: var(--clrPlaceholderText,#BDBDBD); content: attr(data-placeholder); font-size: 12pt; font-weight: 400; }

.WACRibbonPanel { position: relative; }

.HideRibbon { display: none; }

.WACDocumentPanel { bottom: 0px; }

.GraphicsEditorRibbonPanel { width: 100%; }

.VersionHistoryOverlay { display: block; height: calc(100% + 22px); position: absolute; top: 0px; width: 100%; z-index: 998; }

.VersionHistoryOverlay.RegionComposer { height: calc(-48px + 100vh); top: 48px; }

.VersionHistoryOverlay.RegionComposer.NoAppHeader { height: 100vh; top: 0px; }

div.SingleOutlineLayout div.Outline { border: 1px hidden red; display: inline-block; min-width: 1.5in; padding-bottom: 0.375in; position: relative; margin-left: 0px !important; margin-right: 0px !important; }

td.GhostDisplayNone { cursor: not-allowed; display: none; }

td.Ghost { background-color: rgb(240, 242, 244); cursor: not-allowed; }

td.GhostWithBorder { background-color: rgb(239, 239, 239); border: 1px dashed rgb(163, 163, 163); cursor: not-allowed; }

td.SkippedGhostCell { background-color: transparent; cursor: default; }

div.Outline { overflow: clip; width: 100%; }

div.OutlineContent { background-color: transparent; height: 100%; padding: 0px; }

.OutlineContainerTransition { transition-duration: 0.4s; transition-property: width; transition-timing-function: cubic-bezier(0.1, 0.36, 0.2, 1); }

table.Table td { padding-bottom: 0px; padding-top: 0px; }

.TableWordWrap { table-layout: fixed; width: 1px; }

.TableCellContent { overflow: visible; }


.WACDocumentPanelContent.SquiggleUpdate { --urlSpellingErrorV2DarkMode: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI1IiBoZWlnaHQ9IjQiPjxnIGZpbGw9Im5vbmUiIGZpbGwtcnVsZT0iZXZlbm9kZCI+PHBhdGggc3Ryb2tlPSIjRTM3RDgxIiBkPSJNMCAzYzEuMjUgMCAxLjI1LTIgMi41LTJTMy43NSAzIDUgMyIvPjxwYXRoIGQ9Ik0wIDBoNXY0SDB6Ii8+PC9nPjwvc3ZnPg=="); --urlContextualSpellingAndGrammarErrorV2DarkMode: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI1IiBoZWlnaHQ9IjMiPjxnIGZpbGw9Im5vbmUiIGZpbGwtcnVsZT0iZXZlbm9kZCIgc3Ryb2tlPSIjOTlBQUY1IiBzdHJva2UtbGluZWNhcD0icm91bmQiPjxwYXRoIGQ9Ik0wIC41aDVNMCAyLjVoNSIvPjwvZz48L3N2Zz4="); --urlAdvancedProofingIssueV2DarkMode: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMCIgaGVpZ2h0PSIyIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxwYXRoIGQ9Ik0wIDBoMTB2MkgweiIvPjxwYXRoIHN0cm9rZT0iI0FEQTJGMiIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2Utd2lkdGg9IjIiIGQ9Ik0xIDFoNCIvPjwvZz48L3N2Zz4="); --similarityReviewedDarkMode: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI1IiBoZWlnaHQ9IjMiPjxwYXRoIGZpbGw9Im5vbmUiIGZpbGwtcnVsZT0iZXZlbm9kZCIgc3Ryb2tlPSIjNTRCMDU0IiBzdHJva2Utd2lkdGg9IjIiIGQ9Ik0wIDEuNWg1Ii8+PC9zdmc+"); --similarityUnreviewedDarkMode: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMCIgaGVpZ2h0PSIyIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxwYXRoIGQ9Ik0wIDBoMTB2MkgweiIvPjxwYXRoIHN0cm9rZT0iIzVDQTlFNSIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2Utd2lkdGg9IjIiIGQ9Ik0xIDFoNCIvPjwvZz48L3N2Zz4="); }

.WACDocumentPanelContentFocused { border: 2px dashed rgb(119, 119, 119); }

.WACViewPanel { color: windowtext; direction: ltr; outline-style: none; overflow: auto; }

.WACViewPanel.mWeb { overflow-y: auto; scrollbar-width: none; }

.WACViewPanel.mWebIphone { touch-action: pan-x pan-y; }

.WACViewPanel, .WACViewPanelLoading { inset: 0px; position: absolute; }

.iPad .WACViewPanel { user-select: text; }

.Themed .WACInteractiveView, .WACInteractiveView { background-color: var(--clrDocSurfaceBg,window); }

.Mac .Themed .WACInteractiveView, .Mac .WACInteractiveView { background-color: var(--clrDocSurfaceBgExplicit,#ffffff); }

.Selected, .Selected p, .Selected p *, .Selected.MergeHighlight, .Themed .Selected, .Themed .Selected p, .Themed .Selected p *, .Themed .Selected.MergeHighlight { background-color: var(--clrSelection,#c6c6c6) !important; }

::highlight(Selected) { background-color: var(--clrSelection,#c6c6c6) !important; }

.Selected p .NewSelectedHighlightColor, .Selected p.NewSelectedHighlightColor, .Selected.MergeHighlight.NewSelectedHighlightColor, .Selected.NewSelectedHighlightColor, .Themed .Selected p .NewSelectedHighlightColor, .Themed .Selected p.NewSelectedHighlightColor, .Themed .Selected.MergeHighlight.NewSelectedHighlightColor, .Themed .Selected.NewSelectedHighlightColor, .Themed span.Selected.FindHit.NewSelectedHighlightColor { background-color: var(--clrBlack,#000000) !important; }

::highlight(Selected-HighContrast) { background-color: var(--clrBlack,#000000) !important; color: var(--clrWhite,#ffffff) !important; }

.SelectedTextColor { color: var(--clrWhite,#ffffff) !important; }

.TrackChangeTextInsertion .SelectedTextColor { text-decoration-line: underline !important; text-decoration-thickness: initial !important; text-decoration-style: initial !important; text-decoration-color: var(--clrWhite,#ffffff) !important; }

.EOP.Selected, .LineBreakBlob.Selected, .Selected .EOP, .TabRun.Selected, .TextRun .Selected, .Themed .EOP.Selected, .Themed .LineBreakBlob.Selected, .Themed .Selected .EOP, .Themed .TabRun.Selected, .Themed .TextRun .Selected { border-color: var(--clrSelection,#c6c6c6) !important; }

.EOP.Selected.SelectionWithBorder, .LineBreakBlob.Selected.SelectionWithBorder, .Selected .EOP.SelectionWithBorder, .TabRun.Selected.SelectionWithBorder, .TextRun .Selected.SelectionWithBorder, .Themed .EOP.Selected.SelectionWithBorder, .Themed .LineBreakBlob.Selected.SelectionWithBorder, .Themed .Selected .EOP.SelectionWithBorder, .Themed .TabRun.Selected.SelectionWithBorder, .Themed .TextRun .Selected.SelectionWithBorder { border-bottom-width: 1px !important; border-bottom-style: solid !important; border-bottom-color: var(--clrWhite,#ffffff) !important; border-top-width: 1px !important; border-top-style: solid !important; border-top-color: var(--clrWhite,#ffffff) !important; }

.EOP.Selected.SelectionPipeBegin, .LineBreakBlob.Selected.SelectionPipeBegin, .Selected .EOP.SelectionPipeBegin, .TabRun.Selected.SelectionPipeBegin, .TextRun .Selected.SelectionPipeBegin, .Themed .EOP.Selected.SelectionPipeBegin, .Themed .LineBreakBlob.Selected.SelectionPipeBegin, .Themed .Selected .EOP.SelectionPipeBegin, .Themed .TabRun.Selected.SelectionPipeBegin, .Themed .TextRun .Selected.SelectionPipeBegin { margin-left: -1px; border-left-width: 1px !important; border-left-style: solid !important; border-left-color: var(--clrWhite,#ffffff) !important; }

.EOP.Selected.SelectionPipeEnd, .LineBreakBlob.Selected.SelectionPipeEnd, .Selected .EOP.SelectionPipeEnd, .TabRun.Selected.SelectionPipeEnd, .TextRun .Selected.SelectionPipeEnd, .Themed .EOP.Selected.SelectionPipeEnd, .Themed .LineBreakBlob.Selected.SelectionPipeEnd, .Themed .Selected .EOP.SelectionPipeEnd, .Themed .TabRun.Selected.SelectionPipeEnd, .Themed .TextRun .Selected.SelectionPipeEnd { margin-right: -1px; border-right-width: 1px !important; border-right-style: solid !important; border-right-color: var(--clrWhite,#ffffff) !important; }

div.CanvasSelected, span.CanvasSelected { position: absolute; background-color: var(--clrSelection,#c6c6c6) !important; }

.Highlight { outline: transparent solid 1px; }

.Padding { background-color: transparent !important; background-image: none !important; }

.HiddenParagraph .Highlight { outline: none; }

.Hyperlink span.Selected, .Underlined span.Selected { text-decoration: underline; }

.Strikethrough span.Selected { text-decoration: line-through; }

.Selected span .NoteTagImage { border-bottom: none; margin-bottom: 0px; background-color: transparent !important; }

.TableRowSelected > td > div.TableCellContent, .TableRowSelected > th > div.TableCellContent { background-color: rgba(198, 198, 198, 0.7) !important; }

.TableRowSelectedThemed > td > div.TableCellContent, .TableRowSelectedThemed > th > div.TableCellContent { background-color: var(--clrTableSelection,rgba(198,198,198,.7)) !important; }

.TableRowSelectedRevamped > td, .TableRowSelectedRevamped > th { background-color: transparent; box-shadow: rgba(174, 198, 235, 0.4) 0px 0px 0px 9999px inset; box-sizing: border-box; position: relative; }

.TableCellSelected, .TableCellSelectedThemed { outline: transparent dashed 2px; background-color: rgba(198, 198, 198, 0.7) !important; }

.TableCellSelectedThemed { background-color: var(--clrTableSelection,rgba(198,198,198,.7)) !important; }

.TableCellSelectedRevamped { outline: transparent dashed 2px; position: relative; }

.TableCellSelectedRevamped::before { background-color: rgba(174, 198, 235, 0.4); inset: 0px; content: ""; pointer-events: none; position: absolute; z-index: 1; }

.TableCellSelectedRevamped.tableRowOrColumnDisabledDuringDragSelectionState::before { background-color: rgba(230, 230, 230, 0.6) !important; }

.TableCellSelectedRevamped > * { position: relative; z-index: 2; }

td.tableRowOrColumnDisabledDuringDragSelectionState:not(.TableCellSelectedRevamped) { background-color: transparent; box-shadow: rgba(230, 230, 230, 0.6) 0px 0px 0px 9999px inset; box-sizing: border-box; position: relative; }

.RightBorderSelected > .TableColumnResizeHandle { background-color: rgba(198, 198, 198, 0.7) !important; }

.RightBorderSelectedThemed > .TableColumnResizeHandle { background-color: var(--clrTableSelection,rgba(198,198,198,.7)) !important; }

.TableRightBorderSelected > tbody > tr > td.LastCol > .TableColumnResizeHandle { background-color: rgba(198, 198, 198, 0.7) !important; }

.TableRightBorderSelectedThemed > tbody > tr > td.LastCol > .TableColumnResizeHandle { background-color: var(--clrTableSelection,rgba(198,198,198,.7)) !important; }

.TableInsideVerticalBorderSelected > tbody > tr > td:not(.LastCol) > .TableColumnResizeHandle { background-color: rgba(198, 198, 198, 0.7) !important; }

.TableInsideVerticalBorderSelectedThemed > tbody > tr > td:not(.LastCol) > .TableColumnResizeHandle { background-color: var(--clrTableSelection,rgba(198,198,198,.7)) !important; }

.HitHighlighted { background-color: rgb(255, 238, 128); }

.Themed span.Selected.FindHit, span.Selected.FindHit { background-color: var(--clrActiveFindHighlightSelection,#96b5da) !important; }

.Themed span.FindHit, span.FindHit { background-color: var(--clrActiveFindHighlight,#ffee80) !important; }

::highlight(FindHit) { background-color: var(--clrActiveFindHighlight,#ffee80) !important; }

::highlight(FindHit-Selected) { background-color: var(--clrActiveFindHighlightSelection,#96b5da) !important; }

span.NormalTextRun::highlight(SpellingError) { text-decoration-color: var(--clrSpellingCorrectionsTextDecor,#EB0000); text-decoration-line: underline; text-decoration-skip-ink: none; text-decoration-style: wavy; text-decoration-thickness: 1px; text-underline-offset: 2px; }

div.SpellingErrorLightMode span.NormalTextRun::highlight(SpellingError), td.SpellingErrorLightMode span.NormalTextRun::highlight(SpellingError) { text-decoration-color: rgb(235, 0, 0); }

div.SpellingErrorDarkMode span.NormalTextRun::highlight(SpellingError), td.SpellingErrorDarkMode span.NormalTextRun::highlight(SpellingError) { text-decoration-color: rgb(227, 125, 129); }

div.SpellingErrorWhite span.NormalTextRun::highlight(SpellingError), td.SpellingErrorWhite span.NormalTextRun::highlight(SpellingError) { text-decoration-color: rgb(255, 255, 255); }

div.SpellingErrorBlack span.NormalTextRun::highlight(SpellingError), td.SpellingErrorBlack span.NormalTextRun::highlight(SpellingError) { text-decoration-color: rgb(0, 0, 0); }

span.NormalTextRun::highlight(GrammarError) { text-decoration-color: var(--clrGrammarCorrectionsTextDecor,#3355FF); text-decoration-line: underline; text-decoration-skip-ink: none; text-decoration-style: double; text-decoration-thickness: 1px; text-underline-offset: 2px; }


td.LowContrastShading div.ClipboardView td.LowContrastShading span[data-contrast="auto"], td.LowContrastShading span[data-contrast="auto"] { color: white !important; }

td.HighContrastShading span[data-contrast="auto"], td.LowContrastShading div.ClipboardView span[data-contrast="auto"], td.LowContrastShading div.ClipboardView td.HighContrastShading span[data-contrast="auto"] { color: windowtext !important; }

div.LowContrastShading span[data-contrast="auto"] { color: white !important; }

div.HighContrastShading span[data-contrast="auto"] { color: windowtext !important; }

.WACViewPanel { -webkit-tap-highlight-color: transparent; z-index: 0; background-color: transparent !important; }

.iPad .WACViewPanel { transform: translateZ(0px); }

.WACViewPanel.Rtl { direction: rtl; }

.WACTaskPaneContainer { height: 100%; position: absolute; top: 0px; z-index: 1; }

.WACTaskPaneContainer.FlexBoxLayout { display: flex; }

.WACTaskPaneContainer.FlexBoxLayout.regionComposer { position: relative; }

.AppRtl .WACTaskPaneContainer.alignLeft, .WACTaskPaneContainer.alignRight { border-left: 1px solid rgb(225, 225, 225); border-right: 0px; left: auto; right: 0px; }

.AppRtl .WACTaskPaneContainer.alignLeft.WACReactTaskPaneContainer, .WACTaskPaneContainer.alignRight.WACReactTaskPaneContainer { border-left: 0px; }

.WACTaskPaneContainer.alignRight.WACReactTaskPaneContainer div#tabbedTaskPaneContainer div[class^="WacTaskpaneContainer"], .WACTaskPaneContainer.alignRight.WACReactTaskPaneContainer div#tabbedTaskPaneContainer div[class^="header"] { background-color: var(--clrEnhancedFishbowlBackgroundColor,#f5f5f5); }

.AppRtl .WACTaskPaneContainer.alignRight, .WACTaskPaneContainer.alignLeft { border-left: 0px; border-right: 1px solid rgb(225, 225, 225); left: 0px; right: auto; }

.AppRtl .WACTaskPaneContainer.alignRight.WACReactTaskPaneContainer, .WACTaskPaneContainer.alignLeft.WACReactTaskPaneContainer { border-right: 0px; }

#HeadingsContainer button { margin-bottom: 0px; margin-top: 0px; padding-bottom: 4px; padding-top: 4px; }

.WACTaskPaneEntry { float: left; height: 100%; }

.AppRtl .WACTaskPaneEntry { float: right; }

.BeforePageContent { display: flex; grid-area: 1 / 1; justify-content: center; margin-bottom: 19px; overflow: visible; position: relative; }

.PageContentOrigin { margin-top: 0px; position: absolute; z-index: 3; }

.mWeb .PageContentOrigin { margin-top: 0px; }

.CssCenteredSection .PageContentContainer, .CssCenteredSection .PageContentOrigin { width: 100%; }

.PageContentOrigin .Paragraph { white-space: pre-wrap; }

#m_skeletalUXContainer .SkeletalPage { background-color: var(--clrEnhancedFishbowlBackgroundColor); height: 100%; left: 0px; margin-bottom: 60px; overflow: auto; position: absolute; right: 0px; top: 125px; transition: opacity 0.2s; width: 100%; z-index: 1009; }

#m_skeletalUXContainer .SkeletalPage.SkeletalMLR { top: 184px; }

#m_skeletalUXContainer .SkeletalPage.ResponsiveUxAuto { top: calc(var(--responsiveUxHeight) + 48); }

#m_skeletalUXContainer .SkeletalPage.ResponsiveUxTabsOnly { top: 86px; }

#m_skeletalUXContainer .SkeletalCanvas { background-color: var(--clrDocSurfaceBg,window); border: 1px solid rgb(171, 171, 171); border-radius: 4px; height: 1056px; margin-bottom: 19px; margin-left: auto; margin-right: auto; overflow: hidden; position: relative; top: 19px; width: 816px; }

#m_skeletalUXContainer .CanvasContentPlaceholder { box-sizing: border-box; height: 100%; padding: 96px; width: 100%; }

#m_skeletalUXContainer .CanvasContentPlaceholder > div { background-color: rgb(237, 235, 233); height: 18px; margin-bottom: 16px; width: 150px; }

#m_skeletalUXContainer .SkeletalCanvas.skeletalDarkMode .CanvasContentPlaceholder > div { background-color: rgb(61, 61, 61); }

@keyframes fadeInOutAnimation { 
  0% { animation-timing-function: linear; opacity: 0; }
  39% { opacity: 1; }
  66.66% { animation-timing-function: cubic-bezier(0.33, 0, 0.67, 1); opacity: 1; }
  97.2% { opacity: 0; }
  100% { opacity: 0; }
}

#m_skeletalUXContainer .FadeInOutElement { animation: 2398ms ease 0s infinite normal none running fadeInOutAnimation; }

#SkeletalContainer { height: 100%; opacity: 1; pointer-events: none; position: absolute; transition: opacity 0.2s; visibility: visible; width: 100%; z-index: 1000; }

#SkeletalContainer .SkeletalRibbon { margin-top: 48px; }

#SkeletalContainer .ribbonContent { background-color: rgb(243, 242, 241); border-bottom: none; height: 76px; min-width: 640px; transition: opacity 0.1s; width: 100%; }

#SkeletalContainer .ribbonContent.SkeletalMLR { height: 135px; }

#SkeletalContainer .ribbonContent.ResponsiveUxTabsOnly { height: 38px; }

#SkeletalContainer .ribbonContent.ResponsiveUxAuto { height: var(--responsiveUxHeight); }

#SkeletalContainer .ribbonContent.skeletalFluent2Style { background-color: rgb(245, 245, 245); }

#SkeletalContainer .ribbonContent.skeletalDarkMode { background-color: rgb(37, 36, 35); }

#SkeletalContainer .ribbonContent.skeletalDarkMode.skeletalFluent2Style { background-color: rgb(20, 20, 20); }

#SkeletalContainer .topbar { align-items: center; display: flex; height: 38px; justify-content: space-between; width: 100%; }

#SkeletalContainer .topbarTabs { display: flex; height: 16px; justify-content: flex-start; }

#SkeletalContainer .topbarRect { border: 1px solid transparent; border-radius: 2px; height: 100%; margin-left: 8px; margin-right: 8px; outline: transparent; }

#SkeletalContainer .topbarRect.skeletalFluent2Style { background-color: rgb(235, 235, 235); }

#SkeletalContainer .topbarRect.skeletalDarkMode { background-color: rgb(50, 49, 48); }

#SkeletalContainer .topbarRect.skeletalDarkMode.skeletalFluent2Style { background-color: rgb(61, 61, 61); }

#SkeletalContainer .collabCorner { display: flex; height: 24px; }

#SkeletalContainer .collabCircle { border: 1px solid transparent; border-radius: 50%; margin-left: 4px; margin-right: 4px; outline: transparent; width: 24px; }

#SkeletalContainer .collabCircle.skeletalFluent2Style { background-color: rgb(235, 235, 235); }

#SkeletalContainer .collabCircle.skeletalDarkMode { background-color: rgb(50, 49, 48); }


.wapsw_ODC_TileSway_110x110x32 { left: -225px; top: -1px; }

.wapsw_ODC_TileWord_110x110x32 { left: -225px; top: -113px; }

.wapsw_ODC_TileSkype_110x110x32 { left: -1px; top: -225px; }

.wapsw_ODC_TilePeople_110x110x32 { left: -113px; top: -225px; }

.wapsw_ODC_TileOneNote_110x110x32 { left: -225px; top: -225px; }

.wapsw_ODC_TileFlow_110x110x32 { left: -337px; top: -1px; }

.wapsw_ODC_TileCloudLogo_110x110x32 { left: -337px; top: -113px; }

.wapsw_ODC_TileCalendar_110x110x32 { left: -337px; top: -225px; }

.AppHeaderPanel { background-color: rgb(0, 0, 0); }

.WACFrame { background-color: rgb(225, 225, 225); }

.WACFastView { z-index: 900; }

.WACFastViewPositionRewrite { grid-area: 2 / 2; position: relative; }

.WACFastViewNavOreoGrid, .WACFastViewPositionRewrite { background-color: rgb(255, 255, 255); z-index: 90; }

.WACFastViewEditable * { user-select: text; }

.WACFastViewEditor :hover { cursor: text; }

.WACFastViewEditor .NormalTextRun { width: 100%; }

.WACFastViewAbsolute { bottom: 0px; left: 0px; position: absolute; top: 30px; width: 100%; }

.WACFastViewAbsolute.Deeplink { opacity: 1; transition: opacity 0.2s; }

.WACFastViewAbsolute.RibbonPinned { top: 124px; }

.WACFastViewAbsolute.RibbonPinned.Touch { top: 138px; }

.WACFastViewAbsolute.SkeletalFastView { left: 393px; }

.WACFastViewAbsolute.SkeletalFastView.Snackbar, .WACFastViewAbsolute.SkeletalFastView.Snackbar.TwoPaneNav { left: 426px; }

.WACFastViewAbsolute.RibbonPinned.SkeletalFastViewViewMode { top: 40px; }

.WACFastViewAbsolute.SkeletalFastViewNoNavpane { left: 0px; }

.WACFastViewAbsolute.SkeletalFastViewPageColumnNavpane { left: 200px; }

.WACFastViewAbsolute.OneLineRibbon.SkeletalFastViewViewMode { top: 40px; }

.WACFastViewAbsolute.OneLineRibbon { top: 73px; }

.WACFastViewAbsolute.OneLineRibbonWithTabHeaderRefresh { top: 77px; }

.WACFastViewAbsolute.HeaderAndRibbonHidden { top: 0px; }

.WACFastViewAbsolute .WACViewPanel { height: 100%; }

.WACFastViewMLRVisible.OneLineRibbonWithTabHeaderRefresh, .WACFastViewRegionComposer:first-child, :not(#WACRibbonPanel):first-child ~ .WACFastViewRegionComposer { top: 125px; }

.WACFastViewRegionComposer.WACFastViewMLRVisible.OneLineRibbonWithTabHeaderRefresh:first-child, :not(#WACRibbonPanel):first-child ~ .WACFastViewRegionComposer.WACFastViewMLRVisible.OneLineRibbonWithTabHeaderRefresh { top: 175px; }

.WACFastViewMLRVisible.OneLineRibbonWithTabHeaderRefresh.TabsOnly, .WACFastViewRegionComposer.WACFastViewMLRVisible.OneLineRibbonWithTabHeaderRefresh:first-child.TabsOnly, .WACFastViewRegionComposer:first-child.TabsOnly, :not(#WACRibbonPanel):first-child ~ .WACFastViewRegionComposer.TabsOnly, :not(#WACRibbonPanel):first-child ~ .WACFastViewRegionComposer.WACFastViewMLRVisible.OneLineRibbonWithTabHeaderRefresh.TabsOnly { top: 80px; }

.WACFastLoadingOverlay { display: block; height: 100%; z-index: 1000; }

.WACFastLoadingBoxUI { inset: 0px; height: 40px; margin: auto; position: absolute; width: 40px; z-index: 1001; }

.WacFlexBoxAppContainer { display: flex; flex: 1 1 auto; flex-flow: row; position: relative; }

.WACRibbonPlaceholder { width: 100%; z-index: 1000; }

.WACFastBootLoader { display: block; height: 35px; left: 6px; position: absolute; top: 6px; width: 35px; }

.AppRtl .WACFastBootLoader { left: auto; right: 6px; }

@-webkit-keyframes fastbootspin { 
  100% { transform: rotate(1turn); }
}

@keyframes fastbootspin { 
  100% { transform: rotate(1turn); }
}

.WACReadingBarPanel, .WACRibbonPanel { left: 0px; overflow: hidden; position: absolute; top: 0px; width: 100%; }

.WACRibbonPanel { max-width: 100vw; }

.WACRibbonPanel.FlexBoxLayout { flex: 0 1 auto; position: relative; z-index: 100; }

.cui-exth .WACRibbonPanel { overflow: visible; }

.WACDocumentPanel { color: rgb(0, 0, 0); left: 0px; position: absolute; right: 0px; }

.WACDocumentPanel.SharedRegionComposer { height: 100%; }

.WACDocumentPanel.FishbowlBackgroundEnhancementEnabled { background-color: var(--clrEnhancedFishbowlBackgroundColor); }

.WACDocumentPanel.FlexBoxLayout, .WACDocumentPanelGrid.FlexBoxLayout { flex: 1 1 auto; position: relative; }

.WACDocumentPanelContent, .WACDocumentPanelContentFocused, .WACViewPanelContainer { inset: 0px; position: absolute; }

.WACDocumentPanelContent.regionComposer { inset: 0px; height: 100%; min-width: 50vw; position: relative; }

.WACViewPanelContainer.WACReactTaskPanes { transition-duration: 0.325s; transition-timing-function: ease; }


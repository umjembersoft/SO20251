.cui-ctl-menu32 .cui-fa-menu-arrow { top: 14px; }

.cui-ctl-menu48 .cui-fa-menu-arrow { top: 21px; }

.cui-ctl-initials { background-color: orange; border-radius: 17px; color: white; float: left; font-size: 120%; height: 32px; line-height: 32px; margin-left: 4px; margin-right: 4px; overflow: hidden; text-align: center; width: 32px; }

.AppRtl .cui-ctl-initials { float: right; }

.cui-separator { background-color: rgb(198, 198, 198); cursor: default; display: inline-block; height: 16px; margin: 7px 7px 0px; vertical-align: top; width: 1px; }

.cui-singlerowlayout .cui-separator { margin: 5px 7px 0px; }


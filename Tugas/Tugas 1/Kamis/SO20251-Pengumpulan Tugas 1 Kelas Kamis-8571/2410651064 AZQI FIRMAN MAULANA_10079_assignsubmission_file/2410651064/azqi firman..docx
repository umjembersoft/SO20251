#linebox1 { animation-duration: ; animation-delay: ; animation-iteration-count: ; animation-direction: ; animation-fill-mode: ; animation-play-state: ; animation-name: ; animation-timeline: ; animation-range-start: ; animation-range-end: ; animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1); }

@keyframes linebox1-first-scale-down { 
  0% { transform: scale(1, 1); opacity: 1; }
  13.3333% { transform: scale(1, 1); opacity: 1; }
  20% { opacity: 1; }
  37.6667% { opacity: 0; transform: scale(0.8, 0.8); }
  100% { opacity: 0; transform: scale(0.8, 0.8); }
}

.line { position: absolute; left: 0px; height: calc(var(--line-height) + 0.5px); width: var(--line-width); will-change: transform, opacity; }

.line1 { top: 0px; border-radius: var(--box-radius) var(--box-radius) 0px 0px; background-color: var(--line-color1); }

.line2 { top: var(--line-height); background-color: var(--line-color2); }

.line3 { top: calc(var(--line-height) * 2); background-color: var(--line-color3); }

.line4 { top: calc(var(--line-height) * 3); border-radius: 0px 0px var(--box-radius) var(--box-radius); background-color: var(--line-color4); }

#w-box { width: var(--w-size); height: var(--w-size); position: absolute; left: var(--w-left); top: calc(var(--anim-container-height) / 2 - var(--w-size) / 2); background: linear-gradient(150deg, rgb(35, 104, 196) 0%, rgb(26, 93, 190) 50%, rgb(17, 70, 172) 100%); border-radius: var(--box-radius); box-shadow: var(--box-shadow); }

#svg-w { position: relative; width: 100%; height: 100%; top: 3px; left: 0px; }

#linebox2 { box-shadow: none; }

#linebox2 .line { left: 0px; transform-origin: left center; box-shadow: var(--box-shadow); will-change: transform, opacity; }

#box2l1 { transform: scaleX(0.4); }

#box2l2 { transform: scaleX(0.3); }

#box2l3 { transform: scaleX(0.2); }

#box2l4 { transform: scaleX(0.1); }

#linebox2 .line { animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1); }

@keyframes linebox2-opacity { 
  0% { opacity: 0; }
  22.6667% { opacity: 0; }
  24.3333% { opacity: 1; }
  46% { opacity: 1; }
  100% { opacity: 1; }
}

#linebox2 .line { animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1); --anim-props: var(--total-duration) linear infinite normal forwards; box-shadow: var(--box-shadow); }

#box2l1 { animation: linebox2-opacity var(--anim-props), box2l1-expand var(--anim-props); }

@keyframes box2l1-expand { 
  22.6667% { transform: scaleX(0.4); }
  46% { transform: scaleX(1); }
  100% { transform: scaleX(1); }
}


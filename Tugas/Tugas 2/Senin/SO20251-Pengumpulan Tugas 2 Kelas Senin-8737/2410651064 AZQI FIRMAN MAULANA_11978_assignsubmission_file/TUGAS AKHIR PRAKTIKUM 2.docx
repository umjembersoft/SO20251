@charset "utf-8";

.clip16x16, .clip19x40, .clip20x20, .clip23x45, .clip24x24, .clip32x32, .clip40x40, .clip48x48 { position: relative; overflow: hidden; }

.clip16x16 { width: 16px; height: 16px; }

.clip19x40 { width: 19px; height: 40px; }

.clip20x20 { width: 20px; height: 20px; }

.clip23x45 { width: 23px; height: 45px; }

.clip24x24 { width: 24px; height: 24px; }

.clip32x32 { width: 32px; height: 32px; }

.clip40x40 { width: 40px; height: 40px; }

.clip48x48 { width: 48px; height: 48px; }

.clip16x16 img, .clip16x16 input, .clip19x40 img, .clip19x40 input, .clip20x20 img, .clip20x20 input, .clip23x45 img, .clip23x45 input, .clip24x24 img, .clip24x24 input, .clip32x32 img, .clip32x32 input, .clip40x40 img, .clip40x40 input, .clip48x48 img, .clip48x48 input { position: absolute; margin: 0px; padding: 0px; width: auto; height: auto; }

.officeLogoTile { top: -1px; left: -1px; }

.scrollbar { top: -51px; left: -1px; }

.fontSize1Selected { top: -1px; left: -51px; }

.fontSize2Selected { top: -51px; left: -26px; }

.fontSize3Selected { top: -1px; left: -93px; }

.fontSize4Selected { top: -43px; left: -68px; }

.fontSize5Selected { top: -98px; left: -1px; }

.toolbarIndL { top: -93px; left: -43px; }

.openInClient { top: -85px; left: -68px; }

.openInClientWhiteIcon { top: -1px; left: -135px; }

.openInClientInactive { top: -43px; left: -110px; }

.changeFontSizeIcon { top: -85px; left: -110px; }

.wordLogo { top: -140px; left: -1px; }

.toolbarIndR { top: -135px; left: -43px; }

.hostui { top: -127px; left: -64px; }

.fontSize5 { top: -127px; left: -106px; }

.fontSize4 { top: -1px; left: -177px; }

.fontSize3 { top: -43px; left: -152px; }


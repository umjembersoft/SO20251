" class="layer" style="z-index: 2; visibility: visible;"><div id="m_content" style="font-size: 100%; overflow-y: auto; direction: ltr; right: 20px;"><div><div id="m_topBuffer" style="height: 200px; display: none;"><img src="https://res.public.onecdn.static.microsoft/officeonline/hashed/79b48a07e8b20228/spiral.gif" class="loading" style="top: calc(50% + 20px);"></div><div id="pc1"><div style="height: 0px;"></div><div class="pageNumV2">1 / 11</div><div id="p1" name="p1"><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;">TUGAS AKHIR PRAKTIKUM <br></span></b></div><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;">SISTEM OPERASI <br></span></b></div><div style="position: relative; height: 75px; width: 74.2612px; overflow: hidden;"><img "="" id="pi1_0" width="189.16429896031934" style="position: absolute; top: -40.1096px; left: -57.8408px; clip: rect(40.1096px, 132.102px, 115.11px, 57.8408px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/fd4eed6a-5f4d-4991-b764-f2edaa46fddc"></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">I <br></span></div><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;">Nama:Azqi Firman Maulana. <br></span></b></div><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;">No:2410651064 <br></span></b></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div></div><hr class="pageHrV2"></div><div id="pc2"><div class="pageNumV2">2 / 11</div><div id="p2" name="p2"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">Tugas 1: Sistem Manajemen Proses <br></span></div><div style="position: relative; height: 71.3967px; width: 75px; overflow: hidden;"><img "="" id="pi2_0" width="98.2829864335686" style="position: absolute; top: -16.0352px; left: -11.6394px; clip: rect(16.0352px, 86.6394px, 87.4319px, 11.6394px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/97748bb4-5d18-46db-ba67-41c2d9821407"></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div></div><hr class="pageHrV2"></div><div id="pc3"><div class="pageNumV2">3 / 11</div><div id="p3" name="p3"><div style="position: relative; height: 73.7494px; width: 75px; overflow: hidden;"><img "="" id="pi3_0" width="98.2829864335686" style="position: absolute; top: -11.6394px; left: -11.6394px; clip: rect(11.6394px, 86.6394px, 85.3888px, 11.6394px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/2ee0a7c7-7c6e-4a22-aa01-08789f89af6d"></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"></div></div><hr class="pageHrV2"></div><div id="pc4"><div class="pageNumV2">4 / 11</div><div id="p4" name="p4"><div style="position: relative; height: 73.9846px; width: 75px; overflow: hidden;"><img "="" id="pi4_0" width="98.2829864335686" style="position: absolute; top: -11.6394px; left: -11.6394px; clip: rect(11.6394px, 86.6394px, 85.6241px, 11.6394px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/a130219e-d6c4-4a88-8f0b-875424efe683"></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">#include &lt;stdio.h&gt; &nbsp; &nbsp; &nbsp;// input/output <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">#include &lt;stdlib.h&gt; &nbsp; &nbsp; // fungsi umum (malloc, rand, exit) <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">#include &lt;unistd.h&gt; &nbsp; &nbsp; // fungsi fork(), getpid() <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">#include &lt;sys/wait.h&gt; &nbsp; // fungsi waitpid() <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">#include &lt;time.h&gt; &nbsp; &nbsp; &nbsp; // menghitung waktu eksekusi <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">#include &lt;string.h&gt; &nbsp; &nbsp; // manipulasi string <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">double waktu_eksekusi(struct timespec start, struct timespec end) <br></span></div><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;">3. Fungsi Tugas Child <br></span></b></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">Setiap child menjalankan satu fungsi: <br></span></div><ul style="margin-left:32px;"><li><div style="direction:ltr;"><span style="direction:ltr;">Â· tugas_sorting() â†’ bubble sort array acak. <br></span></div></li><li><div style="direction:ltr;"><span style="direction:ltr;">Â· tugas_searching() â†’ mencari nilai tertentu dalam array. <br></span></div></li></ul></div><hr class="pageHrV2"></div><div id="pc5"><div class="pageNumV2">5 / 11</div><div id="p5" name="p5"><ul style="margin-left:32px;"><li><div style="direction:ltr;"><span style="direction:ltr;">Â· tugas_calculation() â†’ menghitung penjumlahan angka 1 sampai 1.000.000. <br></span></div></li></ul><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">Tujuannya hanya <b><span style="direction:ltr;">simulasi beban kerja CPU</span></b><span style="direction:ltr;"> yang berbeda. <br></span></span></div><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;">4. Bagian main() <br></span></b></div><ul style="margin-left:32px;"><li><div style="direction:ltr;"><span style="direction:ltr;">Â· Parent membuat 3 proses anak dalam <b><span style="direction:ltr;">loop for (i = 0; i &lt; 3; i++)</span></b><span style="direction:ltr;">. <br></span></span></div></li><li><div style="direction:ltr;"><span style="direction:ltr;">Â· Sebelum fork(), waktu awal disimpan (clock_gettime()). <br></span></div></li><li><div style="direction:ltr;"><span style="direction:ltr;">Â· Setelah fork(): <br></span></div></li><ul style="margin-left:32px;"><li><div style="direction:ltr;"><span style="direction:ltr;">o <b><span style="direction:ltr;">Child process (pid == 0)</span></b><span style="direction:ltr;"> menjalankan salah satu tugas di atas dan keluar (exit(0)). <br></span></span></div></li><li><div style="direction:ltr;"><span style="direction:ltr;">o <b><span style="direction:ltr;">Parent process</span></b><span style="direction:ltr;"> menunggu anak selesai (waitpid()), lalu mencatat waktu selesai dan <span style="direction:ltr;">menampilkan hasil. <br></span></span></span></div></li></ul></ul><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;">5. Output yang ditampilkan <br></span></b></div><div style="position: relative; height: 58.2714px; width: 75px; overflow: hidden;"><img "="" id="pi5_0" width="98.2829864335686" style="position: absolute; top: -48.1674px; left: -11.6394px; clip: rect(48.1674px, 86.6394px, 106.439px, 11.6394px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/8673471d-9d60-432e-973a-0ee30b3cd958"></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp;<br></span></div></div><hr class="pageHrV2"></div><div id="pc6"><div class="pageNumV2">6 / 11</div><div id="p6" name="p6"><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;">Tugas 2: Chat Application dengan IPC <br></span></b></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="position: relative; height: 73.2169px; width: 75px; overflow: hidden;"><img "="" id="pi6_0" width="98.2829864335686" style="position: absolute; top: -19.7499px; left: -11.6394px; clip: rect(19.7499px, 86.6394px, 92.9668px, 11.6394px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/92d3fd0d-4c3d-492a-973b-d5dffd1117d2"></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div></div><hr class="pageHrV2"></div><div id="pc7"><div class="pageNumV2">7 / 11</div><div id="p7" name="p7"><div style="position: relative; height: 73.2046px; width: 75px; overflow: hidden;"><img "="" id="pi7_0" width="98.2829864335686" style="position: absolute; top: -11.6394px; left: -11.6394px; clip: rect(11.6394px, 86.6394px, 84.844px, 11.6394px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/be53e7e1-e295-4b35-b36b-99189d72f0f6"></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div></div><hr class="pageHrV2"></div><div id="pc8"><div class="pageNumV2">8 / 11</div><div id="p8" name="p8"><div style="position: relative; height: 73.9846px; width: 75px; overflow: hidden;"><img "="" id="pi8_0" width="98.2829864335686" style="position: absolute; top: -11.6394px; left: -11.6394px; clip: rect(11.6394px, 86.6394px, 85.6241px, 11.6394px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/8434bfc3-15d1-4c0b-90a4-6d814869426e"></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="position: relative; height: 32.8752px; width: 75px; overflow: hidden;"><img "="" id="pi8_1" width="98.2829864335686" style="position: absolute; top: -86.689px; left: -11.6394px; clip: rect(86.689px, 86.6394px, 119.564px, 11.6394px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/922c8824-a9bc-4169-829c-e5dc4883e9d7"></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">Program <b><span style="direction:ltr;">chat_ipc.c</span></b><span style="direction:ltr;"> ini adalah simulasi <b><span style="direction:ltr;">aplikasi chat sederhana</span></b><span style="direction:ltr;"> antara dua pengguna â€” <b><span style="direction:ltr;">Ageng</span></b><span style="direction:ltr;"> dan <b><span style="direction:ltr;">Azqi</span></b><span style="direction:ltr;"> â€” menggunakan <b><span style="direction:ltr;">shared memory</span></b><span style="direction:ltr;"> dan <b><span style="direction:ltr;">semaphore</span></b><span style="direction:ltr;">. <br></span></span></span></span></span></span></span></div></div><hr class="pageHrV2"></div><div id="pc9"><div class="pageNumV2">9 / 11</div><div id="p9" name="p9"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;">ðŸ“˜<span style="direction:ltr;"> <b><span style="direction:ltr;">Penjelasan singkat:</span></b><span style="direction:ltr;"> <br></span></span></span></div><ul style="margin-left:32px;"><li><div style="direction:ltr;"><span style="direction:ltr;">Â· Shared memory dipakai untuk menyimpan <b><span style="direction:ltr;">pesan chat bersama</span></b><span style="direction:ltr;">. <br></span></span></div></li><li><div style="direction:ltr;"><span style="direction:ltr;">Â· Semaphore menjaga agar <b><span style="direction:ltr;">hanya satu proses</span></b><span style="direction:ltr;"> yang menulis ke chat pada satu waktu <span style="direction:ltr;">(menghindari tabrakan). <br></span></span></span></div></li><li><div style="direction:ltr;"><span style="direction:ltr;">Â· Masing-masing user menjalankan program di terminal berbeda: <br><span style="direction:ltr;">./chat_ipc ageng dan ./chat_ipc azqi. <br></span></span></div></li><li><div style="direction:ltr;"><span style="direction:ltr;">Â· Pesan yang dikirim akan muncul di layar kedua pengguna seperti ruang chat: <br></span></div></li><li><div style="direction:ltr;"><span style="direction:ltr;">Â· Saat <b><span style="direction:ltr;">Ageng atau azqi keluar terakhir</span></b><span style="direction:ltr;">, program otomatis menghapus shared memory <span style="direction:ltr;">dan semaphore agar bersih <br></span></span></span></div></li></ul><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;">OUTPUT: </span></b><b><span style="direction:ltr;"> <br></span></b></div><div style="position: relative; height: 17.9421px; width: 75px; overflow: hidden;"><img "="" id="pi9_0" width="98.2829864335686" style="position: absolute; top: -44.3536px; left: -11.6394px; clip: rect(44.3536px, 86.6394px, 62.2957px, 11.6394px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/26c569ee-ed3a-4b7a-9ffd-4bd744976b96"></div><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;"> <br></span></b></div><div style="position: relative; height: 30.4111px; width: 75px; overflow: hidden;"><img "="" id="pi9_1" width="98.2829864335686" style="position: absolute; top: -66.8648px; left: -11.6394px; clip: rect(66.8648px, 86.6394px, 97.2759px, 11.6394px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/af243614-0d7b-439c-93ab-e6be70532b5f"></div><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;"> <br></span></b></div><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;"> <br></span></b></div><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;"> <br></span></b></div><div style="position: relative; height: 13.7692px; width: 75px; overflow: hidden;"><img "="" id="pi9_2" width="98.2829864335686" style="position: absolute; top: -105.498px; left: -11.6394px; clip: rect(105.498px, 86.6394px, 119.267px, 11.6394px); visibility: visible;" src="blob:https://word-edit.officeapps.live.com/8a22357c-b9e0-4640-a682-584ffc23bbae"></div><div style="direction:ltr;margin-top:5px"><b><span style="direction:ltr;"> <br></span></b></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp;<br></span></div></div><hr class="pageHrV2"></div><div id="pc10"><div class="pageNumV2">10 / 11</div><div id="p10" name="p10"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> &nbsp;<br></span></div></div><hr class="pageHrV2"></div><div id="pc11"><div class="pageNumV2">11 / 11</div><div id="p11" name="p11"><div style="direction:ltr;margin-top:5px"><span style="direction:ltr;"> <br></span></div></div><hr class="pageHrV2"></div><div id="m_endBuffer" style="height: 200px; display: none;"><img src="https://res.public.onecdn.static.microsoft/officeonline/hashed/79b48a07e8b20228/spiral.gif" class="loading"></div></div></div></div><div id="m_loadingLayer" class="layer" style="z-index: 1; visibility: visible; display: none;"><img src="https://res.public.onecdn.static.microsoft/officeonline/hashed/79b48a07e8b20228/spiral.gif" id="m_loadingImage" class="loading"></div></div> 
